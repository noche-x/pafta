{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build with tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MAP_EDITOR_CPP_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-msvc",
      "displayName": "Developer build with tests (MSVC)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/dev-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "MAP_EDITOR_CPP_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci",
      "displayName": "CI build with tests",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MAP_EDITOR_CPP_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci-msvc",
      "displayName": "CI build with tests (MSVC)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/ci-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "MAP_EDITOR_CPP_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "targets": ["map_editor_cpp", "map_editor_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests"]
    },
    {
      "name": "dev-msvc",
      "configurePreset": "dev-msvc",
      "configuration": "Debug",
      "targets": ["map_editor_cpp", "map_editor_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests"]
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "targets": ["map_editor_cpp", "map_editor_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests"]
    },
    {
      "name": "ci-msvc",
      "configurePreset": "ci-msvc",
      "configuration": "Release",
      "targets": ["map_editor_cpp", "map_editor_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-msvc",
      "configurePreset": "dev-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-msvc",
      "configurePreset": "ci-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
