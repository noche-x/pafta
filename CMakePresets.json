{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build with tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PAFTA_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-msvc",
      "displayName": "Developer build with tests (MSVC)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/dev-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "PAFTA_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci",
      "displayName": "CI build with tests",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PAFTA_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci-msvc",
      "displayName": "CI build with tests (MSVC)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/ci-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "PAFTA_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "quality",
      "displayName": "Native sanitizer and parser fuzz checks",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/quality",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "PAFTA_ENABLE_SANITIZERS": "ON",
        "PAFTA_BUILD_FUZZERS": "ON",
        "PAFTA_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "targets": ["pafta", "pafta_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests", "editor_workflow_tests"]
    },
    {
      "name": "dev-msvc",
      "configurePreset": "dev-msvc",
      "configuration": "Debug",
      "targets": ["pafta", "pafta_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests", "editor_workflow_tests"]
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "targets": ["pafta", "pafta_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests", "editor_workflow_tests"]
    },
    {
      "name": "ci-msvc",
      "configurePreset": "ci-msvc",
      "configuration": "Release",
      "targets": ["pafta", "pafta_tests", "binary_export_tests", "editor_state_tests", "mesh_export_tests", "editor_workflow_tests"]
    },
    {
      "name": "quality",
      "configurePreset": "quality"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-msvc",
      "configurePreset": "dev-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-msvc",
      "configurePreset": "ci-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    }
  ]
}
